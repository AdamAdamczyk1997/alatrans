---
import { Image } from 'astro:assets';
import { photos } from '../data/photos';
interface Props { name: keyof typeof photos; alt: string; hero?: boolean; sizes?: string; }
const { name, alt, hero = false, sizes = '(max-width: 760px) calc(100vw - 36px), (max-width: 1224px) 45vw, 526px' } = Astro.props;
const photo = photos[name];
const width = Math.min(photo.width, 1600);
---
<Image src={photo} alt={alt} width={width} height={Math.round(width * photo.height / photo.width)} widths={[480, 800, 1200, 1600].filter(w => w <= photo.width)} sizes={sizes} format="webp" quality={80} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async" />
