---
import { navigation, site } from '../data/site';
const year = new Date().getUTCFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-company"><span>© {year} {site.companyName}</span><span>{site.address.display} · baza lawety</span></div>
    <nav aria-label="Nawigacja w stopce">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav>
  </div>
</footer>
