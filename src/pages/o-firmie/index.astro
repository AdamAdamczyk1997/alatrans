---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VehiclePhoto from '../../components/VehiclePhoto.astro';
import { site } from '../../data/site';

// Matches .wrap, .about-grid gap and its 31.5rem / 21rem flex bases in global.css.
const contentWidth = 'min(72.5rem, calc(100vw - 2 * clamp(1.125rem, 0.375rem + 3vw, 2rem)))';
const aboutPhotoSizes = [
  `(min-width: 59.41518em) calc((${contentWidth} - clamp(2rem, 1rem + 4.45vw, 5rem) * 0.8) * 0.4)`,
  `min(40rem, ${contentWidth}, calc(${contentWidth} * 0.8 + 4.2rem))`,
].join(', ');
---

<BaseLayout
  title="O firmie — AlaTrans z Łącka"
  description="AlaTrans – P.P.H.U. Artur Adamczyk z Łącka. Pomoc drogowa 24/7 i transport pojazdów. Bezpośredni kontakt i indywidualne ustalenie warunków zlecenia."
>
  <section class="page-intro">
    <div class="wrap prose">
      <p class="section-kicker">Poznaj AlaTrans</p>
      <h1>O firmie AlaTrans</h1>
      <p class="lead">
        {site.companyName} to lokalna firma z Łącka. Zajmujemy się pomocą drogową i transportem
        pojazdów. Stawiamy na bezpośredni kontakt i jasne ustalenie zakresu usługi.
      </p>
    </div>
  </section>

  <section class="section soft" aria-labelledby="dwa-filary">
    <div class="wrap about-grid">
      <div class="prose">
        <h2 id="dwa-filary">Pomoc na drodze i zaplanowany przewóz</h2>
        <p>
          W ramach pomocy drogowej działamy całodobowo w Łącku, Nowym Sączu, Starym Sączu i
          okolicach. Pomagamy przy unieruchomionych pojazdach i realizujemy holowanie.
        </p>
        <p>
          Transport pojazdów ustalamy z wyprzedzeniem. Przewozimy pojazdy w Polsce, a wybrane
          trasy zagraniczne uzgadniamy indywidualnie, zależnie od zlecenia i możliwości firmy.
        </p>
        <div class="choices">
          <a class="choice primary" href="/pomoc-drogowa/">
            Pomoc drogowa <span aria-hidden="true">→</span>
          </a>
          <a class="choice primary" href="/transport-pojazdow/">
            Transport pojazdów <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <figure>
        <VehiclePhoto
          name="laweta_car_5"
          alt="Laweta AlaTrans z pustą platformą, widok z przodu i z boku"
          sizes={aboutPhotoSizes}
        />
        <figcaption>Laweta AlaTrans</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="jasne-ustalenia">
    <div class="wrap content-grid">
      <div class="prose">
        <h2 id="jasne-ustalenia">Zaczynamy od rozmowy</h2>
        <p>
          Przed realizacją ustalamy lokalizację, rodzaj pojazdu, dostępność i indywidualną wycenę.
          Dzięki temu obie strony znają zakres i warunki usługi.
        </p>
        <a class="text-link" href="/kontakt/">
          Skontaktuj się z nami <span aria-hidden="true">→</span>
        </a>
      </div>
      <aside class="callout" aria-labelledby="zobacz-lawete">
        <h2 id="zobacz-lawete">Zobacz naszą lawetę i przewozy</h2>
        <p>
          Na stronie realizacji znajdziesz autentyczne zdjęcia pojazdu AlaTrans oraz wykonanych
          transportów.
        </p>
        <a class="text-link" href="/realizacje/">
          Przejdź do realizacji <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
