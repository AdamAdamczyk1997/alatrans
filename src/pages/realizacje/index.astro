---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { galleryPhotos } from '../../data/realizacje';

// Auto-fit uses 20rem minimum tracks and 1.25rem gaps within the shared fluid .wrap.
const contentWidth = 'min(72.5rem, calc(100vw - 2 * clamp(1.125rem, 0.375rem + 3vw, 2rem)))';
const gallerySizes = [
  `(min-width: 66.5em) calc((${contentWidth} - 2.5rem) / 3)`,
  `(min-width: 44.68085em) calc((${contentWidth} - 1.25rem) / 2)`,
  contentWidth,
].join(', ');

const gallery = await Promise.all(
  galleryPhotos.map(async (photo) => {
    const scale = Math.min(1, 1600 / Math.max(photo.image.width, photo.image.height));
    const lightbox = await getImage({
      src: photo.image,
      width: Math.round(photo.image.width * scale),
      height: Math.round(photo.image.height * scale),
      format: 'webp',
      quality: 80,
    });
    const portrait = photo.image.height > photo.image.width;
    // Contained portraits occupy a narrower area inside the 4:3 tile.
    // Their thumbnails stay separate from the full 1200 × 1600 lightbox asset.
    const thumbnailWidth = Math.min(photo.image.width, portrait ? 800 : 1200);
    return {
      ...photo,
      lightbox,
      thumbnailWidth,
      thumbnailHeight: Math.round((thumbnailWidth * photo.image.height) / photo.image.width),
      portrait,
    };
  }),
);
---

<BaseLayout
  title="Realizacje i zdjęcia lawety | AlaTrans"
  description="Zobacz autentyczne zdjęcia lawety AlaTrans oraz przewozów samochodów osobowych. Pomoc drogowa i transport pojazdów z bazą w Łącku."
>
  <section class="page-intro gallery-intro">
    <div class="wrap">
      <p class="section-kicker">Nasza laweta i przewozy</p>
      <h1>Realizacje AlaTrans</h1>
      <p class="lead">
        Prawdziwe zdjęcia naszego pojazdu i wykonanych przewozów
      </p>
    </div>
  </section>
  <section class="gallery-section">
    <div class="wrap">
      <h2 class="sr-only">Galeria zdjęć</h2>
      <div class="gallery-grid">
        {gallery.map((photo, i) => (
          <figure class="gallery-item">
            <button
              class="gallery-open"
              type="button"
              data-photo-id={photo.id}
              data-src={photo.lightbox.src}
              data-alt={photo.alt}
              data-width={photo.lightbox.attributes.width}
              data-height={photo.lightbox.attributes.height}
              aria-label={`Powiększ zdjęcie: ${photo.alt}`}
              aria-haspopup="dialog"
            >
              <Image
                class:list={{ 'gallery-portrait': photo.portrait }}
                src={photo.image}
                alt={photo.alt}
                width={photo.thumbnailWidth}
                height={photo.thumbnailHeight}
                widths={[320, 480, 800, 1200].filter((width) => width <= photo.thumbnailWidth)}
                sizes={i === 0 ? gallerySizes : `auto, ${gallerySizes}`}
                format="webp"
                quality={80}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
              />
              <span class="zoom-mark" aria-hidden="true">
                ↗
              </span>
            </button>
          </figure>
        ))}
      </div>
      <noscript>
        <p>
          Zdjęcia w pełnym rozmiarze:{' '}
          {gallery.map((photo, i) => (
            <>
              <a class="text-link" href={photo.lightbox.src} aria-label={`Otwórz zdjęcie: ${photo.alt}`}>
                Zdjęcie {i + 1}
              </a>
              {i < gallery.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </noscript>
    </div>
  </section>
  <dialog id="gallery-dialog" aria-labelledby="gallery-caption">
    <div class="dialog-toolbar">
      <p id="gallery-caption"></p>
      <button class="dialog-close" type="button" aria-label="Zamknij zdjęcie">
        Zamknij <span aria-hidden="true">×</span>
      </button>
    </div>
    <img class="dialog-image" width="1600" height="1200" alt="" />
  </dialog>
</BaseLayout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-dialog');
  const image = dialog?.querySelector<HTMLImageElement>('.dialog-image');
  const caption = dialog?.querySelector<HTMLElement>('#gallery-caption');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.dialog-close');
  let trigger: HTMLButtonElement | null = null;
  if (dialog && image && caption && closeButton) {
    document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach((button) => {
      button.addEventListener('click', () => {
        trigger = button;
        image.src = button.dataset.src ?? '';
        image.alt = button.dataset.alt ?? '';
        caption.textContent = image.alt;
        image.width = Number(button.dataset.width);
        image.height = Number(button.dataset.height);
        dialog.showModal();
        document.body.classList.add('dialog-open');
        closeButton.focus();
      });
    });
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('dialog-open');
      trigger?.focus();
    });
  }
</script>
