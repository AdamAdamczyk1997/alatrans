---
import BaseLayout from '../layouts/BaseLayout.astro';
import VehiclePhoto from '../components/VehiclePhoto.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import { site } from '../data/site';
---
<BaseLayout title="AlaTrans — Pomoc drogowa 24/7 i transport pojazdów" description="Pomoc drogowa 24/7 w Łącku, Nowym Sączu, Starym Sączu i okolicach. Transport pojazdów po Polsce i samochodów z Niemiec. Zadzwoń: 880 887 092.">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Łącko i okolice · dostępność 24/7</p>
        <h1 id="hero-heading">Pomoc drogowa 24/7 – holowanie i transport pojazdów</h1>
        <p class="lead">Pomagamy na drodze w Łącku, Nowym Sączu, Starym Sączu i okolicach. Transportujemy pojazdy na terenie całej Polski oraz samochody z Niemiec.</p>
        <div class="choices">
          <a class="choice primary" href="/pomoc-drogowa/">Pomoc drogowa <span aria-hidden="true">↗</span></a>
          <a class="choice secondary" href="/transport-pojazdow/">Transport pojazdów <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-contact">
          <span class="phone-circle"><PhoneIcon /></span>
          <div><small>Potrzebujesz pomocy? Zadzwoń bezpośrednio</small><a href={site.phoneHref}><strong>{site.phoneDisplay}</strong></a></div>
        </div>
      </div>
      <figure class="hero-art">
        <VehiclePhoto name="laweta_car_4" alt="Laweta AlaTrans z widoczną kabiną i pustą platformą" hero />
        <figcaption class="photo-caption">Prawdziwy pojazd AlaTrans</figcaption>
      </figure>
    </div>
  </section>
  <div class="divider-strip">
    <ul class="wrap strip" aria-label="Najważniejsze informacje">
      <li><span class="tick" aria-hidden="true">✓</span>Pomoc drogowa 24 godziny na dobę</li>
      <li><span class="tick" aria-hidden="true">✓</span>Transport pojazdów po Polsce i z Niemiec</li>
      <li><span class="tick" aria-hidden="true">✓</span>Indywidualna wycena</li>
    </ul>
  </div>
  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-heading"><div><p class="section-kicker">W czym możemy pomóc</p><h2 id="services-heading">Dwie usługi. Prosty kontakt.</h2></div><p>Pomagamy w awaryjnych sytuacjach i realizujemy wcześniej uzgodniony transport.</p></div>
      <div class="services">
        <article class="service">
          <span class="service-mark" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m4 20 9-9m-6-7 13 13-3 3L4 7l3-3Zm8-1a5 5 0 0 0 6 6l-5 5-4-4 5-5"/></svg></span>
          <h3>Pomoc drogowa</h3><p>Holowanie, wyciąganie pojazdów z rowu, wymiana koła, dowóz paliwa i uruchamianie auta z kabli.</p>
          <a class="linkline" href="/pomoc-drogowa/">Poznaj pomoc drogową <span aria-hidden="true">→</span></a>
        </article>
        <article class="service">
          <span class="service-mark" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v10H3zM14 10h4l3 4v3h-7M3 4h11"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
          <h3>Transport pojazdów</h3><p>Przewóz samochodów osobowych, motocykli, quadów oraz wybranych maszyn. Na terenie Polski, a samochodów także z Niemiec.</p>
          <a class="linkline" href="/transport-pojazdow/">Poznaj transport <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>
  <section class="section soft" aria-labelledby="steps-heading">
    <div class="wrap">
      <div class="section-heading"><div><p class="section-kicker">Jak to działa</p><h2 id="steps-heading">Trzy proste kroki</h2></div></div>
      <ol class="step-grid">
        <li class="step"><span class="num" aria-hidden="true">01</span><h3>Kontaktujesz się z nami</h3><p>Dzwonisz i krótko opisujesz sytuację lub planowany transport.</p></li>
        <li class="step"><span class="num" aria-hidden="true">02</span><h3>Ustalamy szczegóły</h3><p>Omawiamy lokalizację, rodzaj pojazdu, dostępność i indywidualną wycenę.</p></li>
        <li class="step"><span class="num" aria-hidden="true">03</span><h3>Realizujemy usługę</h3><p>Po uzgodnieniu warunków przyjeżdżamy na miejsce lub odbieramy pojazd.</p></li>
      </ol>
    </div>
  </section>
  <section class="section" aria-labelledby="area-heading">
    <div class="wrap">
      <div class="section-heading"><div><p class="section-kicker">Obszar działania</p><h2 id="area-heading">Lokalnie i w trasie</h2></div></div>
      <div class="where">
        <div class="where-card"><h3>Pomoc drogowa</h3><p>Łącko, Nowy Sącz, Stary Sącz i okoliczne miejscowości. Dostępność 24/7, także nocą i w święta.</p></div>
        <div class="where-card"><h3>Transport pojazdów</h3><p>Transport na terenie całej Polski oraz samochodów z Niemiec — po wcześniejszym uzgodnieniu.</p></div>
      </div>
    </div>
  </section>
  <section class="section soft" aria-labelledby="about-heading">
    <div class="wrap about-grid">
      <div><p class="section-kicker">O nas</p><h2 id="about-heading">AlaTrans — lokalna firma, konkretna pomoc</h2><p>AlaTrans to firma z Łącka zajmująca się pomocą drogową i transportem pojazdów. Stawiamy na bezpośredni kontakt i jasne ustalenie zakresu usługi.</p><a class="text-link" href="/o-firmie/">Więcej o firmie <span aria-hidden="true">→</span></a></div>
      <aside class="about-aside">Chcesz zobaczyć naszą lawetę i wykonane przewozy?<br /><a href="/realizacje/">Przejdź do realizacji <span aria-hidden="true">→</span></a></aside>
    </div>
  </section>
</BaseLayout>
